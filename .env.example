# Minimal demo configuration
DATA_MODE=demo
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Required when DATA_MODE=database
MYSQL_URL=mysql://medmatch:medmatch@localhost:3306/medmatch
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=medmatch
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_cases
# Optional; defaults to the active embedding provider's output dimensions.
QDRANT_VECTOR_SIZE=

# Optional. When unset, the deterministic local hashing embedder is used.
# When set, Gemini is selected. Use a server-side secret; never expose this key to browser code.
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_EMBEDDING_DIMENSIONS=768
