# Use "demo" for a zero-setup viva/demo or "database" for the full stack.
DATA_MODE=demo
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

MYSQL_URL=mysql://medmatch:medmatch@localhost:3306/medmatch
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=medmatch
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_cases

# Optional. When absent, a deterministic local hashing embedder is used.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
