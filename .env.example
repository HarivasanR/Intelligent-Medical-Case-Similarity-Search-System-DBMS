# Use "demo" for a zero-setup viva/demo or "database" for the full stack.
DATA_MODE=demo
AUTH_SECRET=

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_URL=
MONGO_ROOT_PASSWORD=
MONGODB_URL=
MONGODB_DB=medmatch
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_cases

# Generated locally by npm run setup. Used only when creating seed accounts.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# Separate from older insecure development volumes.
COMPOSE_PROJECT_NAME=medmatch
